    <div class="page-content">
    <div class="content-wrapper">
    <br><br>
    <div class="card">
        <div class="card-body">

            <!-- 🔍 BARRE DE RECHERCHE -->
            <div class="form-group">
                 <h3 class="text-center mb-4">Résultats des prédictions médicales</h3>
                <input type="text" id="searchInput" class="form-control" 
                       placeholder="🔍 Rechercher un patient ou une maladie...">
            </div>

            <!-- 📊 TABLEAU -->
            <table class="table table-bordered table-striped" id="patientTable">
                <thead class="thead-medical">
                    <tr>
                        <th>Patient</th>
                        <th>Image</th>
                        <th>Maladie détectée</th>
                        <th>Confiance (%)</th>
                        <th>Modèle Utilisé</th>
                        <th>Date</th>
                    </tr>
                </thead>

                <tbody>
                    @each(item in predictions)
                    <tr>
                        {{--  <td>@{item.patient}</td>  --}}
                        <td>@ BMM </td>
                        <td><img src="/uploads/{{ item.filename }}" class="thumbnail" alt="Radio" width="60"></td>
                        <td>
                            <span class="badge {{ item.label === 'Normal' ? 'badge-success' : 'badge-danger' }}">
                                {{ item.label }}
                            </span>
                        </td>
                        <td>{{ item.accuracy }}%</td>
                        <td>{{ item.modelUsed }}</td>
                        <td>{{ item.createdAt.toFormat('dd/MM/yyyy HH:mm') }}</td>
                    </tr>
                    @endeach

                    {{--  <tr>
                        <td>Patient 2</td>
                        <td><img src="assets/img/sample.jpg" width="60"></td>
                        <td><span class="badge badge-success">Normal</span></td>
                        <td>87%</td>
                        <td>2026-04-17</td>
                    </tr>  --}}

                </tbody>
            </table>

        </div>
    </div>

    <!-- 🔙 RETOUR -->
    <div class="text-center mt-3">
        <a href="/prediction" class="btn btn-primary">Retour</a>
    </div>
